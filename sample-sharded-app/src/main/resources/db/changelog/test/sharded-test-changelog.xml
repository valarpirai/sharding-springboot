<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Test Changelog for Sharded Databases -->

    <changeSet id="test-shard-1" author="test">
        <comment>Create test table in shard database</comment>
        <createTable tableName="shard_test_data">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="data_key" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="data_value" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <rollback>
            <dropTable tableName="shard_test_data"/>
        </rollback>
    </changeSet>

    <changeSet id="test-shard-2" author="test">
        <comment>Add index on account_id</comment>
        <createIndex indexName="idx_shard_test_account_id" tableName="shard_test_data">
            <column name="account_id"/>
        </createIndex>
        <rollback>
            <dropIndex indexName="idx_shard_test_account_id" tableName="shard_test_data"/>
        </rollback>
    </changeSet>

    <changeSet id="test-shard-3" author="test">
        <comment>Add index on data_key</comment>
        <createIndex indexName="idx_shard_test_data_key" tableName="shard_test_data">
            <column name="data_key"/>
        </createIndex>
        <rollback>
            <dropIndex indexName="idx_shard_test_data_key" tableName="shard_test_data"/>
        </rollback>
    </changeSet>

    <changeSet id="test-shard-4" author="test">
        <comment>Create test audit log table</comment>
        <createTable tableName="shard_test_audit_log">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_type" type="VARCHAR(100)"/>
            <column name="entity_id" type="BIGINT"/>
            <column name="details" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <rollback>
            <dropTable tableName="shard_test_audit_log"/>
        </rollback>
    </changeSet>

    <changeSet id="test-shard-5" author="test">
        <comment>Insert test data into shard</comment>
        <insert tableName="shard_test_data">
            <column name="account_id" valueNumeric="1"/>
            <column name="data_key" value="migration_test"/>
            <column name="data_value" value="Shard migration successful"/>
        </insert>
        <rollback>
            <delete tableName="shard_test_data">
                <where>data_key='migration_test' AND account_id=1</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
